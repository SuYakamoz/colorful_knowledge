# ============================================================
# 配置文件模板:复制本文件为 .env,填入你的密钥即可
#   本地:复制成 .env 填值(config.py 自动读取)
#   云端:不用复制,直接在 GitHub Secret 配同名变量
#   ⚠️ .env 已被 .gitignore 忽略,不会上传 GitHub;本模板可正常提交
# ============================================================

# DeepSeek API Key(必填):https://platform.deepseek.com 申请,充值后可用
DEEPSEEK_API_KEY=

# Server酱 SendKey(必填):https://sct.ftqq.com 注册,微信扫码关注后获取
SERVERCHAN_SENDKEY=

# 以下两个可选:不填则用默认值(deepseek-chat / https://api.deepseek.com)
# 想换任意 OpenAI 兼容模型,填对应模型名与接口地址
# 例:通义千问 DEEPSEEK_MODEL=qwen-plus  DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

# ============================================================
# 推送通道(可选):默认 Server酱;想用企业微信真卡片就配下面这组
# ============================================================
# 通道选择:serverchan(默认)/ wecom(企业微信自建应用,官方 API 真卡片,不经过第三方平台)
PUSH_CHANNEL=serverchan

# 企业微信通道配置:qy.weixin.qq.com 免费注册 → 应用管理 → 创建自建应用 → 拿三个值
WECOM_CORP_ID=      # 企业 ID(我的企业 → 企业信息)
WECOM_AGENT_ID=     # 自建应用的 AgentId(应用管理 → 你的应用 → 可见范围下方)
WECOM_SECRET=       # 自建应用的 Secret(应用管理 → 你的应用 → 点"查看"复制)
WECOM_TOUSER=@all   # 接收人:默认 @all 发全员;只发自己可填你的企业微信 userid
WECOM_CARD_TYPE=markdown  # 卡片类型:markdown(富文本,推荐)/ textcard(文本卡片+跳转按钮)
WECOM_CARD_URL=https://github.com/SuYakamoz/colorful-_knowledge  # textcard 点击跳转链接